#!/usr/bin/env python3
"""Run a command in a PTY and write the raw transcript."""

from __future__ import annotations

import argparse
import os
import pty
import select
import sys
import time


def main() -> int:
    parser = argparse.ArgumentParser(description="Record a command through a PTY")
    parser.add_argument("--output", required=True, help="Transcript path")
    parser.add_argument("--timeout", type=float, default=60.0)
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    command = args.command
    if command and command[0] == "--":
        command = command[1:]
    if not command:
        print("record-pty: missing command after --", file=sys.stderr)
        return 2

    master_fd, slave_fd = pty.openpty()
    pid = os.fork()
    if pid == 0:
        os.close(master_fd)
        os.setsid()
        os.dup2(slave_fd, 0)
        os.dup2(slave_fd, 1)
        os.dup2(slave_fd, 2)
        if slave_fd > 2:
            os.close(slave_fd)
        os.execvp(command[0], command)

    os.close(slave_fd)
    deadline = time.monotonic() + args.timeout
    chunks: list[bytes] = []
    exit_code = 1
    try:
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                os.kill(pid, 15)
                print("record-pty: timed out; sent SIGTERM to child", file=sys.stderr)
                break
            ready, _, _ = select.select([master_fd], [], [], min(remaining, 0.2))
            if ready:
                try:
                    data = os.read(master_fd, 4096)
                except OSError:
                    break
                if not data:
                    break
                chunks.append(data)
            waited = os.waitpid(pid, os.WNOHANG)
            if waited[0] == pid:
                exit_code = os.WEXITSTATUS(waited[1]) if os.WIFEXITED(waited[1]) else 1
                while True:
                    ready, _, _ = select.select([master_fd], [], [], 0.05)
                    if not ready:
                        break
                    try:
                        data = os.read(master_fd, 4096)
                    except OSError:
                        break
                    if not data:
                        break
                    chunks.append(data)
                pid = None
                break
        if pid is not None:
            _, status = os.waitpid(pid, 0)
            if os.WIFEXITED(status):
                exit_code = os.WEXITSTATUS(status)
    finally:
        os.close(master_fd)

    with open(args.output, "wb") as fh:
        fh.write(b"".join(chunks))
    return exit_code


if __name__ == "__main__":
    sys.exit(main())
